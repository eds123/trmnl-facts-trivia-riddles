{% comment %} Quadrant. Landscape 400x240: hero on top, remaining sections side by side below. Portrait 240x400: everything stacked. {% endcomment %}
{% comment %} ---- Landscape ---- {% endcomment %}
<div class="layout layout--col layout--top layout--stretch-x gap--small portrait:hidden">
  {% if side_count == 0 %}
    {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "base", text_size: "small", lines: 5, lg_lines: 7 %}
  {% else %}
    {% comment %} OG landscape: the hero (title--small) and the two side-by-side columns (description) share 114px of measured body-text room. {% endcomment %}
    {% assign q_budget = 114 %}
    {% comment %} Both columns get the same clamp, so the longer side stands in for both. {% endcomment %}
    {% assign longer = side1_body %}{% assign l1 = side1_body | size %}{% assign l2 = side2_body | size %}{% if l2 > l1 %}{% assign longer = side2_body %}{% endif %}
    {% capture alloc %}{% render "alloc3", hero_body: hero_body, side1_body: longer, side2_body: "", hero_size: "small", side_size: "description", width: 190, hero_width: 385, budget: q_budget, dev: "og" %}{% endcapture %}
    {% assign alloc = alloc | strip | split: "," %}
    {% if side_count == 1 %}{% assign alloc = "2,4,0" | split: "," %}{% endif %}
    {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "small", text_size: "small", lines: alloc[0], lg_lines: 3 %}
    <div class="divider divider--h"></div>
    {% if side_count == 1 %}
      {% render "side_card", label: side1_label, body: side1_body, answer: side1_answer, state: answer_state, reveal_label: reveal_label, label_size: "small", body_class: "title title--small", text_size: "small", lines: 4, lg_lines: 6 %}
    {% else %}
    {% comment %} OG: side by side (no vertical room). TRMNL X: three rows like half_vertical. {% endcomment %}
    <div class="columns gap--medium lg:hidden">
      <div class="column flex flex--col flex--left flex--top">
        {% render "side_card", label: side1_short, body: side1_body, answer: side1_answer, state: answer_state, reveal_label: reveal_label, label_size: "small", body_class: "description", text_size: "small", lines: alloc[1], lg_lines: 7 %}
      </div>
      <div class="divider divider--v"></div>
      <div class="column flex flex--col flex--left flex--top">
        {% render "side_card", label: side2_short, body: side2_body, answer: side2_answer, state: answer_state, reveal_label: reveal_label, label_size: "small", body_class: "description", text_size: "small", lines: alloc[1], lg_lines: 7 %}
      </div>
    </div>
    <div class="hidden lg:flex flex--col flex--stretch-x gap--small">
      {% render "side_pair", room: 127, room_lg: 124, width: 385, side_label: "small", side_body: "description", side_text: "small", side1_lg_lines: 3, side2_lg_lines: 3, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
    </div>
    {% endif %}
  {% endif %}
</div>

{% comment %} ---- Portrait (225x353 content) ---- {% endcomment %}
{% if side_count == 0 %}
  {% render "stacked", room: 236, room_lg: 333, hidden: "landscape:hidden", width: 225, gap: "small", hero_size: "base", hero_text: "small", side_label: "small", side_body: "title title--small", side_text: "small", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% elsif side_count == 1 %}
  {% render "stacked", room: 236, room_lg: 333, hidden: "landscape:hidden", width: 225, gap: "small", hero_size: "base", hero_text: "small", side_label: "small", side_body: "title title--small", side_text: "small", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% else %}
  {% render "stacked", room: 236, room_lg: 333, hidden: "landscape:hidden", width: 225, gap: "small", hero_size: "small", hero_text: "small", side_label: "small", side_body: "title title--small", side_text: "small", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% endif %}

