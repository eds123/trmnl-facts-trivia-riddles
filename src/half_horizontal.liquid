{% comment %} Half horizontal 800x240: hero left, sidebar stacked right. {% endcomment %}
{% if side_count == 0 %}
<div class="layout layout--col layout--stretch">
  {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "large", text_size: "base", lines: 3 %}
</div>
{% else %}
<div class="layout layout--row layout--stretch-y gap--medium">
  <div class="basis--96 shrink-0 flex">
    {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "base", text_size: "small", lines: 5 %}
  </div>
  <div class="divider divider--v"></div>
  <div class="grow flex flex--col flex--stretch-x gap--small">
    {% if side_count == 1 %}
      {% render "side_card", label: side1_label, body: side1_body, answer: side1_answer, state: answer_state, reveal_label: reveal_label, label_size: "base", body_class: "title", text_size: "base", lines: 5 %}
    {% else %}
      {% render "side_card", label: side1_label, body: side1_body, answer: side1_answer, state: answer_state, reveal_label: reveal_label, label_size: "small", body_class: "title title--small", text_size: "small", lines: 2 %}
      <div class="divider divider--h"></div>
      {% render "side_card", label: side2_label, body: side2_body, answer: side2_answer, state: answer_state, reveal_label: reveal_label, label_size: "small", body_class: "title title--small", text_size: "small", lines: 3 %}
    {% endif %}
  </div>
</div>
{% endif %}

{% render "plugin_title_bar", instance: instance_label %}
