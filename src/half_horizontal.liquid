{% comment %} Half horizontal. Landscape 800x240: hero left, sidebar stacked right. Portrait 480x400: stacked. {% endcomment %}
{% comment %} ---- Landscape ---- {% endcomment %}
{% if side_count == 0 %}
<div class="layout layout--col layout--stretch portrait:hidden">
  {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "large", text_size: "base", lines: 3, lg_lines: 6 %}
</div>
{% else %}
<div class="layout layout--row layout--stretch-y gap--medium portrait:hidden">
  <div class="basis--96 shrink-0 flex lg:grow">
    {% comment %} Measured: 148px for the hero text = 7 lines of 21px. {% endcomment %}
    {% render "hero_card", label: hero_label, body: hero_body, answer: hero_answer, state: answer_state, reveal_label: reveal_label, title_size: "base", text_size: "small", lines: 7, lg_lines: 8 %}
  </div>
  <div class="divider divider--v"></div>
  <div class="grow flex flex--col flex--stretch-x gap--small lg:basis--96 lg:gap--medium">
    {% if side_count == 1 %}
      {% render "side_card", label: side1_label, body: side1_body, answer: side1_answer, state: answer_state, reveal_label: reveal_label, label_size: "base", body_class: "title", text_size: "base", lines: 5, lg_lines: 6 %}
    {% else %}
      {% render "side_pair", room: 114, room_lg: 226, width: 380, side_label: "small", side_body: "title title--small", side_text: "small", side1_lg_lines: 4, side2_lg_lines: 4, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
    {% endif %}
  </div>
</div>
{% endif %}

{% comment %} ---- Portrait (460x353 content) ---- {% endcomment %}
{% if side_count == 0 %}
  {% render "stacked", room: 236, room_lg: 332, hidden: "landscape:hidden", width: 460, gap: "medium", hero_size: "large", hero_text: "base", side_label: "base", side_body: "title", side_text: "base", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% elsif side_count == 1 %}
  {% render "stacked", room: 236, room_lg: 332, hidden: "landscape:hidden", width: 460, gap: "medium", hero_size: "large", hero_text: "base", side_label: "base", side_body: "title", side_text: "base", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% else %}
  {% render "stacked", room: 236, room_lg: 332, hidden: "landscape:hidden", width: 460, gap: "small", hero_size: "base", hero_text: "small", side_label: "small", side_body: "title title--small", side_text: "small", hero_label: hero_label, hero_body: hero_body, hero_answer: hero_answer, side_count: side_count, side1_label: side1_label, side1_body: side1_body, side1_answer: side1_answer, side2_label: side2_label, side2_body: side2_body, side2_answer: side2_answer, state: answer_state, reveal_label: reveal_label %}
{% endif %}

