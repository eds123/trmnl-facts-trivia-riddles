<div class="layout">
  <div class="columns">
    <div class="column">
      {% render "fact_card", text: fact_text, source: fact_source, lines: 3 %}
    </div>
    <div class="column">
      {% render "riddle_card", question: riddle_question, answer: riddle_answer, state: answer_state, reveal_label: reveal_label, lines: 3 %}
    </div>
  </div>
</div>

{% render "plugin_title_bar", instance: "Fact & Riddle" %}
