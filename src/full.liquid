<div class="layout layout--col gap--large">
  {% render "fact_card", text: fact_text, source: fact_source, lines: 3 %}
  <div class="columns">
    <div class="column">
      {% render "trivia_card", category: trivia_category, question: trivia_question, choices: trivia_choices, answer: trivia_answer, state: answer_state, reveal_label: reveal_label, lines: 3 %}
    </div>
    <div class="column">
      {% render "riddle_card", question: riddle_question, answer: riddle_answer, state: answer_state, reveal_label: reveal_label, lines: 4 %}
    </div>
  </div>
</div>

{% render "plugin_title_bar" %}
